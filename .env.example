# ==============================================================================
# Brahma Jijñāsā — Environment Variables Configuration
# Copy this file to .env.local for local development, and configure these in
# Vercel Project Settings -> Environment Variables for production deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Required for Live Sessions, Profiles & Leaderboards)
# ------------------------------------------------------------------------------
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# (Optional legacy alias supported by client/server helpers)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Public App URL (Required for OAuth redirects)
# ------------------------------------------------------------------------------
# Local development: http://localhost:3000 (or http://localhost:3001)
# Production: https://your-production-domain.vercel.app
NEXT_PUBLIC_APP_URL=https://brahma-jijnasa.vercel.app

# ------------------------------------------------------------------------------
# 3. Google OAuth Credentials (Required for Google Sign-In)
# ------------------------------------------------------------------------------
# Configure in Google Cloud Console -> APIs & Services -> Credentials:
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 4. Role-Based Access Control (Admins and Teachers)
# ------------------------------------------------------------------------------
# Comma-separated list of emails granted Admin or Teacher privileges:
ADMIN_EMAILS=admin@example.com
TEACHER_EMAILS=teacher1@example.com,teacher2@example.com
